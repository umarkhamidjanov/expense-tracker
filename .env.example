# Copy to .env.local (never commit real values) and set the same variables in Vercel.
# Find both in Supabase: Project Settings → API (or "Connect").

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (sb_publishable_…). Older projects: use the "anon" key instead,
# via VITE_SUPABASE_ANON_KEY. Both are safe in the browser because Row Level Security
# protects every table.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# NEVER put the service_role / secret key (sb_secret_…) here or in any VITE_ variable:
# it bypasses Row Level Security, and everything prefixed VITE_ is shipped to browsers.
# The app refuses to start if it detects one.
